<UserControl
    x:Class="MusicDownloader.WPF.Views.VK.VkMusicView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="av"
    Background="#F4F7FB"
    av:DesignHeight="546"
    av:DesignWidth="914">

    <UserControl.Resources>

        <!-- PRIMARY BUTTON -->

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2688EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#1976D2"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#1565C0"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- SECONDARY BUTTON -->

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#273449"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#F7FAFE"/>

                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#C9D9EC"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#EEF6FF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- DOWNLOAD TRACK BUTTON -->

        <Style x:Key="TrackDownloadButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#EAF4FF"/>
            <Setter Property="Foreground" Value="#2688EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#D8ECFF"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#C7E3FF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- PATH BOX -->

        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Background" Value="#F7F9FC"/>
            <Setter Property="Foreground" Value="#455468"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>


        <!-- PROGRESS BAR -->

        <Style x:Key="DownloadProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#E8EEF5"/>
            <Setter Property="Foreground" Value="#2688EB"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3">

                            <Grid>
                                <Border x:Name="Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"/>
                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="Indicator"
                                        Property="Width"
                                        Value="80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>


    <!-- MAIN -->

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- TITLE -->

            <StackPanel Grid.Column="0">

                <StackPanel Orientation="Horizontal">

                    <Border Width="42"
                            Height="42"
                            Background="#2688EB"
                            CornerRadius="12"
                            Margin="0,0,13,0">

                        <TextBlock Text="♫"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="VK Музыка"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#172033"/>

                        <TextBlock x:Name="TrackCountText"
                                   Text="Треков: 0"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="#8793A5"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>


            <!-- MAIN MENU -->

            <Button x:Name="MainMenuButton"
                    Grid.Column="1"
                    Content="Главное меню"
                    Width="145"
                    Height="40"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="MainMenuButton_Click"/>


      


            <!-- REFRESH -->

            <Button x:Name="LoadButton"
                    Grid.Column="3"
                    Content="Обновить"
                    Width="112"
                    Height="40"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="LoadButton_Click"/>


            <!-- DOWNLOAD ALL -->

            <Button x:Name="DownloadAllButton"
                    Grid.Column="4"
                    Content="Скачать всё"
                    Width="130"
                    Height="40"
                    Style="{StaticResource PrimaryButton}"
                    Click="DownloadAllButton_Click"/>

        </Grid>


        <!-- SAVE DIRECTORY -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                Padding="16"
                BorderBrush="#E7ECF2"
                BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- NAME -->

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Папка загрузки"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#172033"/>

                    <TextBlock Text="Место сохранения музыки"
                               FontSize="10"
                               Foreground="#8995A7"
                               Margin="0,3,0,0"/>

                </StackPanel>


                <!-- PATH -->

                <Border Grid.Column="1"
                        Height="38"
                        Background="#F7F9FC"
                        CornerRadius="9"
                        VerticalAlignment="Center">

                    <TextBox x:Name="OutputDirectoryTextBox"
                             Text=""
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource PathBox}"/>

                </Border>


                <!-- SELECT -->

                <Button x:Name="SelectDirectoryButton"
                        Grid.Column="2"
                        Content="Выбрать"
                        Height="38"
                        Margin="10,0,0,0"
                        Padding="18,8"
                        Style="{StaticResource SecondaryButton}"
                        Click="SelectDirectoryButton_Click"/>

            </Grid>

        </Border>


        <!-- TRACKS CARD -->

        <Border Grid.Row="4"
                Background="White"
                CornerRadius="16"
                BorderBrush="#E7ECF2"
                BorderThickness="1"
                Padding="14">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- LIST HEADER -->

                <Grid Grid.Row="0">

                    <TextBlock Text="Моя музыка"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               VerticalAlignment="Center"/>

                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="StatusText"
                                   Text="Загрузка музыки..."
                                   FontSize="11"
                                   Foreground="#8995A7"
                                   HorizontalAlignment="Right"/>

                        <ProgressBar x:Name="DownloadProgressBar"
                                     Width="180"
                                     Height="5"
                                     Margin="0,6,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Visibility="Collapsed"/>

                    </StackPanel>

                </Grid>


                <!-- TRACKS LIST -->

                <ListBox x:Name="TracksList"
                         Grid.Row="4"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemContainerStyle>

                        <Style TargetType="ListBoxItem">

                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>

                            <Setter Property="Padding"
                                    Value="0"/>

                            <Setter Property="Margin"
                                    Value="0,3"/>

                        </Style>

                    </ListBox.ItemContainerStyle>


                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Border Background="#F8FAFD"
                                    BorderBrush="#EDF1F6"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>


                                    <!-- MUSIC ICON -->

                                    <Border Grid.Column="0"
                                            Width="38"
                                            Height="38"
                                            Background="#EAF4FF"
                                            CornerRadius="10"
                                            VerticalAlignment="Center">

                                        <TextBlock Text="♪"
                                                   FontSize="18"
                                                   Foreground="#2688EB"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>


                                    <!-- TRACK INFO -->

                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,10,0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Artist}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#172033"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="11"
                                                   Foreground="#7E8A9C"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>


                                    <!-- DURATION -->

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Duration}"
                                               FontSize="12"
                                               Foreground="#8A96A8"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,12,0"/>


                                    <!-- DOWNLOAD -->

                                    <Button Grid.Column="3"
                                            Content="↓"
                                            ToolTip="Скачать трек"
                                            Style="{StaticResource TrackDownloadButton}"
                                            Click="DownloadTrackButton_Click"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>


                <!-- EMPTY -->

                <StackPanel x:Name="EmptyState"
                            Grid.Row="4"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">

                    <Border Width="64"
                            Height="64"
                            Background="#F1F5F9"
                            CornerRadius="18"
                            HorizontalAlignment="Center">

                        <TextBlock Text="♪"
                                   FontSize="30"
                                   Foreground="#AEBAC9"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <TextBlock Text="Музыка не найдена"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0"/>

                    <TextBlock Text="В вашей музыкальной библиотеке пока нет треков."
                               FontSize="11"
                               Foreground="#8995A7"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>
