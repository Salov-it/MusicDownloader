<Window x:Class="MusicDownloader.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicDownloader"
        Width="1000"
        Height="650"
        MinWidth="850"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#F5F8FC"
        Foreground="#172033">

    <Window.Resources>

        <!-- PRIMARY BUTTON -->

        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2688EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E78D3"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1769BD"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        <!-- PROVIDER BUTTON -->

        <Style x:Key="ProviderButton"
               TargetType="Button">

            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="BorderBrush" Value="#DCE5F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ProviderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="ProviderBorder"
                                        Property="BorderBrush"
                                        Value="#2688EB"/>

                                <Setter TargetName="ProviderBorder"
                                        Property="Background"
                                        Value="#F7FBFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ProviderBorder"
                                        Property="Background"
                                        Value="#EDF6FF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ProviderBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>


        <!-- ====================================================== -->
        <!-- HEADER -->
        <!-- ====================================================== -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E4EBF3"
                BorderThickness="0,0,0,1">

            <Grid Margin="30,0">

                <!-- LOGO AND TITLE -->

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="42"
                            Height="42"
                            Background="#2688EB"
                            CornerRadius="11">

                        <TextBlock Text="♪"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="13,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="MusicDownloader"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#172033"/>

                        <TextBlock Text="Ваши треки — в одном месте"
                                   FontSize="11"
                                   Foreground="#8491A5"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                </StackPanel>


                <!-- LOGOUT AND VERSION -->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="LogoutButton"
                            Content="Выйти"
                            Style="{StaticResource ProviderButton}"
                            Padding="14,6"
                            Margin="0,0,12,0"
                            Visibility="Collapsed"
                            Click="LogoutButton_Click"/>

                    <Border Background="#F1F6FC"
                            CornerRadius="8"
                            Padding="10,5">

                        <TextBlock Text="v1.0"
                                   FontSize="11"
                                   Foreground="#728198"/>

                    </Border>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ====================================================== -->
        <!-- CONTENT -->
        <!-- ====================================================== -->

        <Grid Grid.Row="1">


            <!-- ================================================== -->
            <!-- HOME CONTENT -->
            <!-- ================================================== -->

            <Grid x:Name="HomeContent"
                  Margin="45">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- WELCOME -->

                <StackPanel Grid.Row="0">

                    <TextBlock Text="Добро пожаловать"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#172033"/>

                    <TextBlock Text="Подключите музыкальный сервис, чтобы начать."
                               Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="#7A879A"/>

                </StackPanel>


                <!-- SERVICES -->

                <StackPanel Grid.Row="2">

                    <TextBlock Text="МУЗЫКАЛЬНЫЕ СЕРВИСЫ"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#8290A4"
                               Margin="0,0,0,12"/>


                    <StackPanel Orientation="Horizontal">

                        <!-- VK -->

                        <Button x:Name="VkButton"
                                Style="{StaticResource ProviderButton}"
                                Width="205"
                                Height="66"
                                Click="VkButton_Click">

                            <StackPanel Orientation="Horizontal">

                                <Border Width="38"
                                        Height="38"
                                        Background="#2688EB"
                                        CornerRadius="10">

                                    <TextBlock Text="VK"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Margin="12,0,0,0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="Музыка VK"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="#172033"/>

                                    <TextBlock x:Name="VkStatusText"
                                               Text="Не авторизован"
                                               FontSize="11"
                                               Foreground="#8A96A8"
                                               Margin="0,3,0,0"/>

                                </StackPanel>

                            </StackPanel>

                        </Button>


                        <!-- YANDEX -->

                        <Button Width="205"
                                Height="66"
                                Margin="12,0,0,0"
                                Style="{StaticResource ProviderButton}"
                                IsEnabled="False">

                            <StackPanel Orientation="Horizontal">

                                <Border Width="38"
                                        Height="38"
                                        Background="#EEF2F7"
                                        CornerRadius="10">

                                    <TextBlock Text="Я"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="#8A96A8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Margin="12,0,0,0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="Яндекс Музыка"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="#7C8798"/>

                                    <TextBlock Text="Скоро"
                                               FontSize="11"
                                               Foreground="#A2ACBA"
                                               Margin="0,3,0,0"/>

                                </StackPanel>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </StackPanel>


                <!-- AUTH CARD -->

                <Border Grid.Row="3"
                        Margin="0,30,0,0"
                        Background="White"
                        BorderBrush="#E1E8F0"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="35">

                    <Grid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="520">

                            <Border Width="76"
                                    Height="76"
                                    Background="#EAF4FF"
                                    CornerRadius="22"
                                    HorizontalAlignment="Center">

                                <TextBlock Text="♪"
                                           FontSize="40"
                                           FontWeight="SemiBold"
                                           Foreground="#2688EB"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <TextBlock Text="Авторизуйтесь через ВКонтакте"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="#172033"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,0"/>


                            <TextBlock Text="Подключите свой аккаунт VK, чтобы получить доступ к вашей музыкальной библиотеке."
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="#7B889B"
                                       FontSize="13"
                                       Margin="0,9,0,25"/>


                            <Button x:Name="LoginButton"
                                    Content="Войти через ВКонтакте"
                                    Width="240"
                                    Height="48"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="VkButton_Click"/>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>


            <!-- ================================================== -->
            <!-- DYNAMIC CONTENT -->
            <!-- ================================================== -->

            <ContentControl x:Name="MainContent"
                            Visibility="Collapsed"/>

        </Grid>


        <!-- ====================================================== -->
        <!-- FOOTER -->
        <!-- ====================================================== -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E4EBF3"
                BorderThickness="0,1,0,0">

            <Grid Margin="30,0">

                <TextBlock Text="MusicDownloader"
                           Foreground="#8A96A8"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <TextBlock Text="VK • Yandex Music"
                           HorizontalAlignment="Right"
                           Foreground="#A0AABA"
                           FontSize="11"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</Window>